{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aosu-desktop",
  "version": "0.1.0",
  "identifier": "com.example.aosu-desktop-unofficial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aosu Desktop (inoffiziell)",
        "width": 900,
        "height": 700
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
